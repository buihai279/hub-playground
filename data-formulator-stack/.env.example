# Data Formulator stack configuration.
#
#   cp .env.example .env
#
# This file is used twice: docker compose reads it for the ${...}
# interpolation in compose.yaml, and the container receives it as its runtime
# environment (env_file). The full upstream reference is .env.template in the
# ../data-formulator submodule.

# ── Stack settings (compose interpolation; harmless inside the container) ──
DF_PORT=5567
# Image tag for the locally built image — bump it when the submodule moves.
DF_IMAGE_TAG=0.8b1
# Override if the submodule checkout does not sit next to this directory.
# DF_BUILD_CONTEXT=../data-formulator

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Signs the Flask session cookie and encrypts session data. When unset, a
# random key is generated on every start, which invalidates all user sessions
# on restart. Generate with:  openssl rand -hex 32
FLASK_SECRET_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────
# Code-execution backend. MUST stay "local" inside a container; the "docker"
# backend cannot work here (upstream DEVELOPMENT.md).
SANDBOX=local

# Workspace persistence.
#   local     — durable storage under DATA_FORMULATOR_HOME (default)
#   ephemeral — temporary storage with TTL/LRU cleanup
# WORKSPACE_BACKEND=local

# ── Exposure / hardening ──────────────────────────────────────────────────
# With AUTH_PROVIDER unset there is no login: anyone who can reach the port can
# drive the app, including running LLM-generated Python through the sandbox.
# The switches below reduce what an anonymous visitor can reach.
#
# Block data connectors (MySQL/PostgreSQL/…), custom LLM endpoints (the server
# would otherwise proxy arbitrary api_base URLs), and API-key display.
# DISABLE_DATA_CONNECTORS=false
# DISABLE_CUSTOM_MODELS=false
# DISABLE_DISPLAY_KEYS=false
#
# Profile-2 shortcut (upstream "multi-user anonymous demo") that enables all
# three of the above at once:
# DISABLE_DATABASE=true
#
# Restrict which api_base URLs custom models may target (fnmatch globs, comma
# separated; an empty api_base is always allowed). Unset = allow any URL.
# DF_ALLOWED_API_BASES=https://api.openai.com*,https://*.openai.azure.com/*,https://api.anthropic.com*

# ── LLM providers (optional) ──────────────────────────────────────────────
# The app needs at least one model to do anything. Either configure providers
# server-side here, or leave them out and let users paste their own key in the
# UI (that requires DISABLE_CUSTOM_MODELS=false).
# OPENAI_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5.5
# ANTHROPIC_ENABLED=true
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-4-20250514
# AZURE_ENABLED=true
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-endpoint.openai.azure.com/
# AZURE_MODELS=gpt-5.4
# Ollama on the Docker host — needs `extra_hosts: ["host.docker.internal:host-gateway"]`
# on the service, since Linux does not provide that name automatically.
# OLLAMA_ENABLED=true
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_MODELS=qwen3:32b

# ── UI ────────────────────────────────────────────────────────────────────
# AVAILABLE_LANGUAGES=en,zh
# LOG_LEVEL=INFO
