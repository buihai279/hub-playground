# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   sed -i'' -e "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$(openssl rand -hex 32)|" \
#             -e "s|^PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=.*|PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=$(openssl rand -hex 32)|" .env

# Public URL users reach the UI at (scheme://host:port). Auth callbacks and
# invite links are derived from it.
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Additional accepted hostnames beyond PAPERCLIP_PUBLIC_URL's host
# (for example a LAN IP or Tailscale alias). Comma-separated.
PAPERCLIP_ALLOWED_HOSTNAMES=

# Required. Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Optional — required only for agents to actually run work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Set to 1 to disable upstream anonymous usage telemetry.
PAPERCLIP_TELEMETRY_DISABLED=0
