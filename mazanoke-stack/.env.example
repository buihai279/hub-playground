# MAZANOKE stack settings — copy to `.env` and edit.
#
#   cp .env.example .env && chmod 600 .env
#
# Everything here is non-secret by default, so a plain copy is fine. If you
# enable basic auth below, `.env` holds a password and should stay mode 600.

# Host port published on the LAN. The container side is fixed at 80.
MAZANOKE_PORT=3474

# Bind address for the published port. 0.0.0.0 exposes it on the LAN and the
# tailnet; 127.0.0.1 restricts it to the host (e.g. behind a reverse proxy).
MAZANOKE_BIND_ADDRESS=0.0.0.0

# Image tag. Pinned to the release rather than `latest`: upstream tags every
# release (v1.0.0 … v1.1.7) alongside `latest` and `dev`.
MAZANOKE_IMAGE_TAG=v1.1.7

# ---------------------------------------------------------------------------
# Optional basic auth. Applied only when BOTH values are non-empty.
#
# Read "Basic auth" in README.md first. Two caveats:
#   1. `PASSWORD` is passed as an environment variable, so anyone in the docker
#      group can read it with `docker inspect`. The stack keeps it empty rather
#      than treating that exposure as acceptable.
#   2. Upstream's basicauth.sh only adds the auth_basic directives to the
#      `location = /index.html` block, so /assets/*, /manifest.json and
#      /service-worker.js stay publicly readable. It gates the app shell, not
#      the files.
# ---------------------------------------------------------------------------
MAZANOKE_USERNAME=
MAZANOKE_PASSWORD=

# ---------------------------------------------------------------------------
# SEO/social metatags. `true` makes the container inject the metatags of the
# OFFICIAL mazanoke.com deployment into the served HTML — they describe the
# upstream hosted product, not this instance, so this stays false.
# See "SEO metatags" in README.md.
# ---------------------------------------------------------------------------
MAZANOKE_METATAGS=false
