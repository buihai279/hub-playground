# Copy to .env and edit. No secrets belong in this file — the API key is read
# from secrets/laya_api_key instead (see README.md).

# Host port, and the port laya-serve binds inside the container.
LAYA_PORT=8000

# Host interface the port is published on. 127.0.0.1 keeps it off the LAN.
LAYA_BIND_ADDRESS=0.0.0.0

# Tag for the locally built image, and the revision to build from.
LAYA_IMAGE_TAG=0.3.22
LAYA_BUILD_CONTEXT=../laya

# ── Runtime ────────────────────────────────────────────────────────────────
# cpu on this host; cuda needs an NVIDIA runtime and nvidia-smi, neither present.
LAYA_DEVICE=cpu

# Laya runs ONNX/inference through torch, which saturates cores easily. 4 of the
# 10 cores leaves room for the MedBASE staging stack on the same box.
LAYA_THREADS=4
OMP_NUM_THREADS=4

LAYA_LOG_LEVEL=info

# 0 = each checkpoint is fetched and built on first use. 1 downloads the whole
# family at boot; expect several GB and a long start_period.
LAYA_PRELOAD=0

# Leave unset for the upstream default of 2 resident checkpoints, which is exactly
# what automatic routing picks between. Capping it at 1 costs 20-23 s per request on
# CPU while the evicted checkpoint rebuilds, so keep it unset unless RAM runs out.
#LAYA_MAX_LOADED=1

# Restrict which checkpoints the Router may pick, comma separated.
# Values: english, multilingual, typed-decisions (see laya/revisions.py).
#LAYA_MODELS=

# 1 lets routing also choose the typed-decisions checkpoint on demand.
#LAYA_AUTO_TASK=0

# Every checkpoint download resolves to this Hub revision; "reviewed" uses the
# pinned SHAs in the package. Empty tracks the Hub default.
#LAYA_REVISION=reviewed

# Base URL prefix when a reverse proxy strips a prefix before forwarding.
#LAYA_ROOT_PATH=

# ── Cache ──────────────────────────────────────────────────────────────────
# Set to 1 to forbid Hub lookups and serve only what is already cached.
HF_HUB_OFFLINE=0

# Named volume holding the checkpoints.
#LAYA_CACHE_VOLUME=hub-playground-laya-model-cache

# ── Hugging Face token (optional) ──────────────────────────────────────────
# The checkpoints are public and download without a token. If anonymous pulls
# get rate limited, put a read token in secrets/hf_token and mount it the same
# way as the API key — as a file, not in this file.
#HF_TOKEN=
