# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   printf 'ODOO_PORT=8069\nPOSTGRES_PASSWORD=%s\nODOO_MASTER_PASSWORD=%s\n' \
#     "$(openssl rand -hex 24)" "$(openssl rand -hex 16)" >> .env

# Host port the Odoo web UI is published on.
ODOO_PORT=8069

# Password for the PostgreSQL `odoo` role. Required.
POSTGRES_PASSWORD=

# Odoo database-manager master password, used at /web/database/manager to
# create, duplicate, back up and drop databases. Required. Treat it as the
# most sensitive secret of the instance: it also guards the DB manager UI.
ODOO_MASTER_PASSWORD=
